generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Roles {
  USER
  SELLER
  ADMIN
}

model User {
  id               Int       @id @default(autoincrement())
  email            String    @unique
  name             String
  addedAt          DateTime  @default(now())
  nickname         String?
  phone_number     String
  shipping_address String
  updatedAt        DateTime  @updatedAt
  order            Order[]
  product          Product[]
}

model Product {
  id          Int      @id @default(autoincrement())
  addedAt     DateTime @default(now())
  userId      Int
  description String?
  name        String
  price       BigInt
  type        String
  quantity    BigInt?
  updatedAt   DateTime @updatedAt
  order       Order[]
  user        User     @relation(fields: [userId], references: [id])
}

model Order {
  id              Int      @id @default(autoincrement())
  userId          Int
  productId       Int
  address         String
  details         String
  quantity        Int
  addedAt         DateTime @default(now())
  payment_status  Boolean
  shipping_status Boolean
  total_price     BigInt
  updatedAt       DateTime @updatedAt
  product         Product  @relation(fields: [productId], references: [id])
  user            User     @relation(fields: [userId], references: [id])
}
